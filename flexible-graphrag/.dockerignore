# Secrets and local config — never bake into image
.env
*.env
.env*
# service account / OAuth key files kept next to .env (GOOGLE_DRIVE / GCS credentials_path)
gcs.json
gen-lang-client.json
*credentials*.json
*service-account*.json

# Python virtual environments
venv*/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Python build artifacts — a stale *.egg-info (or dist-info) copied into the image
# becomes a SECOND importlib.metadata distribution named 'flexible-graphrag' under
# PYTHONPATH=/app, which Langflow reports as a `duplicate-distribution` extension
# error. Keep build metadata out of the image so only the installed dist-info exists.
*.egg-info/
*.egg-info
*.dist-info/
build/
dist/

# Local database directories
ladybug/
arcadedb_data/

# Runtime data
uploads/
logs/
*.log

# Dev / test artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Editor / OS
.git/
.gitignore
.DS_Store
Thumbs.db
